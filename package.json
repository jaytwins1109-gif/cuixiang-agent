{
  "name": "cuixiang",
  "version": "1.0.0",
  "private": true,
  "description": "脆香零食 - AI 陪伴客服 + 零食推荐系统",
  "scripts": {
    "dev": "next dev",
    "dev:log": "next dev > dev.out.log 2> dev.err.log",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "tsc --noEmit && vitest run",
    "guard": "node --import ./scripts/ts-alias-register.mjs scripts/profile-guard.ts && node --import ./scripts/ts-alias-register.mjs scripts/reco-guard.ts",
    "smoke": "node scripts/smoke.mjs",
    "capture-log": "node scripts/capture-log.mjs",
    "gen-password": "node scripts/gen-password.mjs",
    "prune-memory": "node --import ./scripts/ts-alias-register.mjs scripts/prune-memory.ts",
    "promote-admin": "node --import ./scripts/ts-alias-register.mjs scripts/promote-admin.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:backup": "node --import ./scripts/ts-alias-register.mjs scripts/backup-db.ts",
    "db:seed": "node --import ./scripts/ts-alias-register.mjs prisma/seed.ts",
    "migrate-json": "node scripts/migrate-memory-json.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.15",
    "lucide-react": "^1.70.0",
    "next": "15.1.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "globals": "^15.15.0",
    "postcss": "8.5.1",
    "prettier": "^3.9.10",
    "prisma": "^6.19.3",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  }
}
