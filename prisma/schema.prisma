// prisma/schema.prisma
//
// V2.0 数据层：把「长期记忆」从 data/memory.json 搬进 SQLite。
//
// 几条刻意的取舍（改之前先读，别按直觉"优化"）：
//   1. layer / status / polarity 用 String 不用 enum —— SQLite 不支持 Prisma enum。
//      类型安全由 lib/memory/store.ts 里的 TS 联合类型守住，库里只是文本。
//   2. 不加 @@unique([userId, layer, keyword, status]) —— 现有语义允许同一个 keyword
//      同时存在 active / deleted / superseded 多行（软删除要留痕）。加唯一键会在
//      状态流转时直接冲突。去重仍由事务内的 findFirst 完成。
//   3. category / polarity / source / createdAt 是用户清单里没写、但现有代码在用的字段，
//      不落库就是静默丢数据。
//   4. User.id 沿用现有的 u_xxx / guest_xxx：游客升级成正式用户时**不换 id**，
//      记忆天然继承，不需要搬数据。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // file:../data/cuixiang.db —— 相对 schema 所在目录，最终落在项目根的 data/ 下。
  // data/ 已被 .gitignore 排除，库文件和归档备份都在一起。
  url      = env("DATABASE_URL")
}

/// 用户：游客与注册用户同一张表，靠 isGuest 区分
model User {
  id        String   @id // u_xxx / guest_xxx，升级时不换
  email     String?  @unique // 游客为 null
  password  String? // bcrypt hash，游客为 null
  isGuest   Boolean  @default(true)
  /// "USER" | "ADMIN"（SQLite 无 enum，类型安全由 lib/auth 的 TS 联合类型守）
  /// 签发 JWT 时作为快照写进 payload；缺省 USER，旧 token 自动降级
  role      String   @default("USER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memories Memory[]
  messages Message[]
}

/// 长期记忆：替代 data/memory.json 里的 MemoryRecord[]
model Memory {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// core_profile | summary_memory | fragment_memory
  layer   String
  keyword String
  content String
  /// active | pending | resolved | superseded | deleted
  status  String  @default("active")
  /// 适用场景，没有则 null
  context String?

  /// 「过敏忌口」等分类，factsFromMessage / decideMemoryAction 用
  category String?
  /// 喜欢 | 不喜欢 | 拒绝 | 接受 | 中立 | 不确定
  polarity String?
  /// 「对话提取」「冲突确认」
  source   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 召回按 (userId, layer, status) 过滤，写盘上限按 (userId, updatedAt) 排序
  @@index([userId, layer, status])
  @@index([userId, updatedAt])
}

/// 聊天日志（V3.0 Admin「对话审查」数据源）。
/// 写入原则：日志写挂不阻断对话（logMessage 失败只打点）；
/// 只存用户看得到的内容（用户原话 / 模型最终回复），trace 原始 JSON 不落这里。
model Message {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// "user" | "assistant"（SQLite 无 enum）
  role    String
  /// 用户原话 / 模型 final 定稿文本（流式不存中间 delta）
  content String
  /// 推荐卡数组的 JSON 文本（SQLite 无 Json scalar，读取方 JSON.parse）；user 轮为 null
  cards   String?
  /// 关联本轮 TraceID，Admin 审查时一键回溯
  traceId String?

  createdAt DateTime @default(now())

  // 对话审查按用户翻页；看板按时间聚合
  @@index([userId, createdAt])
  @@index([createdAt])
}

/// 商品表（V3.0「库为源、内存为算」）：
/// Admin 在后台改库 → 写路径刷新内存缓存 → 检索链路照旧读内存数组，零 async 化。
/// snacks.ts 降级为 seed 数据源；数组字段存 JSON 文本（SQLite 无 scalar list）。
model Product {
  id    String @id @default(cuid())
  skuId String @unique
  name  String @unique // 业务键：卡片、理由、守卫断言全按 name 引用
  category String
  price    Float
  /// 一句话卖点（卡片展示）——原 reason
  reason   String
  emoji    String
  /// 以下数组字段均为 JSON 文本，如 '["辣味","甜味"]'
  tasteTagsJson      String @default("[]")
  scenesJson         String @default("[]")
  emotionsJson       String @default("[]")
  sellingPointsJson  String @default("[]")
  allergensJson      String @default("[]")
  /// 0=不辣 1=微辣 2=中辣 3=重辣（口味强约束用）
  spicy    Int     @default(0)
  giftOk   Boolean @default(false)
  childOk  Boolean @default(false)
  /// "in_stock" | "out_of_stock"
  stock    String  @default("in_stock")
  quality  Float   @default(85)
  margin   Int     @default(0)
  /// 软下架：Admin 停售不删数据；内存缓存只加载 active
  active   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
