# 复制一份改名 .env.local 再填值。本文件不含任何真实密钥。

# ===== 大脑 =====
# deepseek（主） / glm（备）；填了哪个就用哪个，另一个有 Key 时自动兜底切换
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ===== 备用大脑（智谱 GLM）=====
# 便宜、快，DeepSeek 挂了或没配时会自动顶上；不填就是没备用
GLM_API_KEY=
GLM_MODEL=glm-4.7-flash

# ===== 工作流编排 =====
# local = 本地工作流（默认，不依赖外部服务）；coze = 扣子工作流（同步）；dify = 自部署 Dify（异步 + 轮询）
ORCHESTRATOR=local
COZE_API_KEY=
COZE_WORKFLOW_ID=

# ===== Dify 备用 =====
DIFY_API_KEY=
DIFY_BASE_URL=http://localhost:3000/v1

# ===== 管理员口令（后台 /admin 访问保护）=====
# 生成：npm run gen-password -- 你的口令
# 留空 = /admin 未启用（fail-closed，不会因为漏配而门户大开）
ADMIN_PASSWORD_HASH=

# ===== 数据库（V2.0，长期记忆落 SQLite）=====
# 这个变量必须写在 .env 里：Prisma CLI 只读 .env，不读 .env.local。
# 路径相对 prisma/schema.prisma 所在目录，所以 ../data 才是项目根的 data/。
DATABASE_URL="file:../data/cuixiang.db"

# ===== 用户鉴权（V2.0）=====
# jose 签 JWT 用的密钥，至少 32 字符，建议 96 位 hex：
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# 换掉即让所有已签发的登录态失效（后台的 ADMIN_PASSWORD_HASH 是另一套，互不影响）。
AUTH_SECRET=

# 接口限流上限（次/分钟/用户）。默认 10，**生产不要配这一行**。
# 本地跑 smoke 时同一个测试用户一分钟要打十几句，配 60 免得用例自己撞 429。
RATE_LIMIT_MAX=
