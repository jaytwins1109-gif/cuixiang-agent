# 复制一份改名 .env.local 再填值。本文件不含任何真实密钥。

# ===== 大脑 =====
# deepseek（主） / glm（备）；填了哪个就用哪个，另一个有 Key 时自动兜底切换
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ===== 备用大脑（智谱 GLM）=====
# 便宜、快，DeepSeek 挂了或没配时会自动顶上；不填就是没备用
GLM_API_KEY=
GLM_MODEL=glm-4.7-flash

# ===== 工作流编排 =====
# local = 本地工作流（默认，不依赖外部服务）；coze = 扣子工作流（同步）；dify = 自部署 Dify（异步 + 轮询）
ORCHESTRATOR=local
COZE_API_KEY=
COZE_WORKFLOW_ID=

# ===== Dify 备用 =====
DIFY_API_KEY=
DIFY_BASE_URL=http://localhost:3000/v1

# ===== 管理员口令（后台 /admin 访问保护）=====
# 生成：npm run gen-password -- 你的口令
# 留空 = /admin 未启用（fail-closed，不会因为漏配而门户大开）
ADMIN_PASSWORD_HASH=
